---
const base=import.meta.env.BASE_URL;
---
<header class="site-header"><div class="shell header-inner"><a class="brand" href={base} aria-label="Trade Avata home"><img class="brand-lockup" data-brand-logo src={`${base}brand/trade-avata-logo.svg`} alt="Trade Avata"/><span class="brand-name">Trade Avata</span></a><nav class="desktop-nav" aria-label="Primary navigation"><a href={base}>Home</a><a href={`${base}analytics/`}>Analytics</a><a href={`${base}journal/`}>Journal</a><a href={`${base}products/`}>Indicators</a><a href={`${base}learn/`}>Courses</a><a href={`${base}market/`}>Market</a><a href={`${base}tools/`}>Tools</a><a href={`${base}about/`}>About</a><a href={`${base}contact/`}>Contact</a></nav><div class="header-actions"><a class="text-link" href={`${base}login/`}>Login</a><a class="button button-small" href={`${base}register/`}>Get Started</a><button class="theme-button" type="button" data-theme-toggle aria-label="Switch theme">☀</button><button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav">☰</button></div></div><div id="mobile-nav" class="mobile-nav" hidden><div class="shell mobile-nav-inner"><a href={base}>Home</a><a href={`${base}analytics/`}>Analytics</a><a href={`${base}journal/`}>Journal</a><a href={`${base}products/`}>Indicators</a><a href={`${base}learn/`}>Courses</a><a href={`${base}market/`}>Market</a><a href={`${base}tools/`}>Tools</a><a href={`${base}about/`}>About</a><a href={`${base}contact/`}>Contact</a><div class="mobile-actions"><a href={`${base}login/`}>Login</a><a class="button" href={`${base}register/`}>Get Started</a></div></div></div></header>
<script is:inline>
const base=window.location.pathname.includes('/NEW-SITE-TRADE-AVATA/')?'/NEW-SITE-TRADE-AVATA/':'/';const toggle=document.querySelector('[data-theme-toggle]'),menu=document.querySelector('[data-menu-toggle]'),mobile=document.querySelector('#mobile-nav');let saved=null;try{saved=localStorage.getItem('ta-theme')}catch{}document.documentElement.dataset.theme=saved==='light'?'light':'dark';toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=next;try{localStorage.setItem('ta-theme',next)}catch{}});menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));mobile.hidden=open});
</script>
<style>
.site-header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--bg) 94%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.header-inner{min-height:62px;display:flex;align-items:center;gap:18px}.brand{display:flex;align-items:center;gap:7px;text-decoration:none;min-width:max-content}.brand-lockup{width:30px;height:30px}.brand-name{font-size:11px;font-weight:900;color:var(--text);white-space:nowrap}.desktop-nav{display:flex;align-items:center;justify-content:center;gap:13px;flex:1}.desktop-nav a,.text-link{font-size:8px;color:var(--muted);text-decoration:none;white-space:nowrap}.desktop-nav a:hover,.text-link:hover{color:var(--text)}.header-actions{display:flex;align-items:center;gap:6px}.theme-button,.menu-button{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:9px;width:31px;height:31px;cursor:pointer}.menu-button{display:none}.mobile-nav{border-top:1px solid var(--line);background:var(--bg)}.mobile-nav-inner{display:grid;gap:2px;padding:10px 0 14px}.mobile-nav-inner>a{padding:9px 2px;color:var(--text);text-decoration:none;font-size:12px}.mobile-actions{display:flex;gap:8px;padding-top:7px}.mobile-actions a{padding:10px 14px;border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--text);font-size:11px}.mobile-actions .button{background:var(--sky);color:#fff;border-color:var(--sky)}
@media(max-width:1180px){.desktop-nav{gap:8px}.desktop-nav a{font-size:7px}.header-inner{gap:10px}}@media(max-width:900px){.desktop-nav{display:none}.menu-button{display:inline-grid;place-items:center}.header-inner{min-height:58px}}@media(max-width:520px){.header-inner{min-height:56px;padding:0 12px}.brand-lockup{width:27px;height:27px}.brand-name{font-size:9px}.header-actions{margin-left:auto}.header-actions .text-link,.header-actions .theme-button{display:none}.header-actions .button{font-size:8px;padding:7px 10px}.menu-button{width:29px;height:29px}}
</style>
