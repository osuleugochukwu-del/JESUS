---
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<header class="site-header">
  <div class="shell header-inner">

    <a
      class="brand"
      href={base}
      aria-label="Trade Avata home"
    >
      <img
        class="brand-lockup"
        data-brand-logo
        src={`${base}brand/trade-avata-logo-light.svg`}
        alt="Trade Avata"
      />

      <span class="brand-name">
        Trade Avata
      </span>
    </a>

    <nav
      class="desktop-nav"
      aria-label="Primary navigation"
    >
      <a href={base}>Home</a>

      <a href={`${base}analytics/`}>
        Analytics
      </a>

      <a href={`${base}journal/`}>
        Journal
      </a>

      <a href={`${base}products/`}>
        Indicators
      </a>

      <a href={`${base}learn/`}>
        Courses
      </a>

      <a href={`${base}market/`}>
        Market
      </a>

      <a href={`${base}tools/`}>
        Tools
      </a>

      <a href={`${base}about/`}>
        About
      </a>

      <a href={`${base}contact/`}>
        Contact
      </a>
    </nav>

    <div class="header-actions">

      <a
        class="text-link"
        href={`${base}login/`}
      >
        Login
      </a>

      <a
        class="button button-small"
        href={`${base}register/`}
      >
        Get Started
      </a>

      <button
        class="theme-button"
        type="button"
        data-theme-toggle
        aria-label="Switch theme"
        aria-pressed="false"
      >
        ☾
      </button>

      <button
        class="menu-button"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        ☰
      </button>

    </div>
  </div>

  <div
    id="mobile-nav"
    class="mobile-nav"
    data-mobile-nav
    hidden
  >
    <div class="shell mobile-nav-inner">

      <a href={base}>
        Home
      </a>

      <a href={`${base}analytics/`}>
        Analytics
      </a>

      <a href={`${base}journal/`}>
        Journal
      </a>

      <a href={`${base}products/`}>
        Indicators
      </a>

      <a href={`${base}learn/`}>
        Courses
      </a>

      <a href={`${base}market/`}>
        Market
      </a>

      <a href={`${base}tools/`}>
        Tools
      </a>

      <a href={`${base}about/`}>
        About
      </a>

      <a href={`${base}contact/`}>
        Contact
      </a>

      <div class="mobile-actions">

        <a href={`${base}login/`}>
          Login
        </a>

        <a
          class="button"
          href={`${base}register/`}
        >
          Get Started
        </a>

      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;

    background:
      color-mix(
        in srgb,
        var(--outer) 92%,
        transparent
      );

    backdrop-filter: blur(16px);

    border-bottom:
      1px solid
      rgba(86, 130, 166, 0.24);
  }

  .header-inner {
    min-height: 64px;

    display: flex;
    align-items: center;

    gap: 18px;
  }

  .brand {
    display: flex;
    align-items: center;

    gap: 8px;

    min-width: max-content;

    text-decoration: none;
  }

  .brand-lockup {
    width: 32px !important;
    height: 32px;

    object-fit: contain;
  }

  .brand-name {
    font-size: 12px;
    font-weight: 900;

    color: #ffffff;

    white-space: nowrap;
  }

  .desktop-nav {
    flex: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 16px;
  }

  .desktop-nav a,
  .text-link {
    color: #c4d2df;

    font-size: 11px;
    font-weight: 600;

    text-decoration: none;

    white-space: nowrap;

    transition:
      color 0.2s ease;
  }

  .desktop-nav a:hover,
  .text-link:hover {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;

    gap: 8px;

    margin-left: auto;
  }

  .theme-button,
  .menu-button {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border:
      1px solid #35516a;

    border-radius: 10px;

    background: #0c2032;

    color: #ffffff;

    cursor: pointer;
  }

  .menu-button {
    display: none;
  }

  .mobile-nav {
    border-top:
      1px solid
      rgba(86, 130, 166, 0.24);

    background: #030a12;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav-inner {
    display: grid;

    gap: 3px;

    padding:
      12px 0 18px;
  }

  .mobile-nav-inner > a {
    padding:
      10px 2px;

    color: #d3deea;

    text-decoration: none;

    font-size: 13px;
  }

  .mobile-actions {
    display: flex;

    gap: 8px;

    padding-top: 10px;
  }

  .mobile-actions > a {
    min-height: 38px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding:
      0 14px;

    border:
      1px solid #35516a;

    border-radius: 10px;

    color: #ffffff;

    text-decoration: none;

    font-size: 12px;
  }

  .mobile-actions .button {
    border-color: #087df0;

    background: #087df0;
  }

  @media (max-width: 1100px) {
    .desktop-nav {
      gap: 10px;
    }

    .desktop-nav a {
      font-size: 10px;
    }
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: grid;
    }
  }

  @media (max-width: 520px) {
    .header-inner {
      min-height: 58px;
    }

    .brand-lockup {
      width: 29px !important;
      height: 29px;
    }

    .brand-name {
      font-size: 10px;
    }

    .text-link,
    .theme-button {
      display: none;
    }

    .button-small {
      min-height: 32px;

      padding:
        0 10px;

      font-size: 9px;
    }

    .menu-button {
      width: 32px;
      height: 32px;
    }
  }
</style>
