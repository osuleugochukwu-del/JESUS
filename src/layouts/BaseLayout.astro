---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SupportChat from "../components/SupportChat.astro";
const {title="Trade Avata — Trade Simple.", description="Trade is simple when you have the right tool."} = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href={`${base}brand/trade-avata-logo.svg`} />
  <script is:inline>
    try{document.documentElement.dataset.theme=localStorage.getItem("ta-theme")==="dark"?"dark":"light"}catch{}
  </script>
</head>
<body data-base-url={base}>
  <Header />
  <main><slot /></main>
  <Footer />
  <SupportChat />
  <script is:inline>
    window.TA={base:document.body.dataset.baseUrl||"/"};
    function applyTATheme(){
      const light=document.documentElement.dataset.theme==="light";
      document.querySelectorAll("[data-theme-toggle]").forEach(b=>{
        b.setAttribute("aria-pressed",String(light));
        b.setAttribute("title",light?"Switch to dark theme":"Switch to light theme");
        b.textContent=light?"☾":"☼";
      });
      document.querySelectorAll("[data-brand-logo]").forEach(img=>{
        img.src=`${window.TA.base}brand/trade-avata-logo${light?"-light":""}.svg`;
      });
    }
    applyTATheme();
    document.addEventListener("click",e=>{
      const t=e.target.closest("[data-theme-toggle]");
      if(t){const next=document.documentElement.dataset.theme==="light"?"dark":"light";document.documentElement.dataset.theme=next;try{localStorage.setItem("ta-theme",next)}catch{}applyTATheme();}
      const m=e.target.closest("[data-menu-toggle]");
      if(m){document.querySelector("[data-mobile-nav]")?.classList.toggle("open");}
    });
  </script>
</body>
</html>