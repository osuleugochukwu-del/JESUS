---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/homepage.css';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Trade Avata — Trade Simple." description="Trading tools, AI analytics, indicators and practical learning in one workspace.">
  <div class="ta-home">
    <section class="ta-ad-banner" data-ad-banner hidden><div class="ta-ad-inner"><span class="ta-ad-label">ADVERTISEMENT</span><div class="ta-ad-copy"><strong data-ad-title>Trade smarter with the right tools.</strong><span data-ad-description>Indicators, AI analytics and practical trading resources.</span></div><a class="ta-ad-button" data-ad-link href="#">Learn more →</a></div></section>

    <section class="ta-hero"><div class="ta-hero-photo"><img src={`${base}images/hero-banner.jpg`} alt="Trade Avata trading workspace preview"/><div class="ta-hero-overlay"></div><div class="ta-container ta-hero-content"><div class="ta-hero-copy"><span class="ta-eyebrow">TRADING TOOLS · ANALYTICS · LEARNING</span><h1>Trading is easier when you have the <span class="ta-blue">right tool.</span></h1><p>Practical trading tools, AI-powered analysis, learning and indicators brought together in one simple workspace.</p><div class="ta-actions"><a class="ta-button" data-hero-primary href={`${base}login/`}>Get Started Free →</a><a class="ta-button ta-button-outline" data-hero-secondary href={`${base}products/`}>Explore Indicators</a></div></div></div></div></section>

    <section class="ta-section ta-intelligence"><div class="ta-container"><div class="ta-section-heading"><span class="ta-mini-label">START WITH INTELLIGENCE</span><h2>Free AI tools for your trading.</h2><p>See the kind of information and review experience Trade Avata is built to provide.</p></div><div class="ta-ai-grid">
      <article class="ta-ai-card"><span class="ta-free">FREE</span><div class="ta-ai-copy"><span class="ta-mini-label">FREE AI ANALYTICS</span><h3>See what your trading data is saying.</h3><p>Performance, risk, drawdown and behaviour insights in one readable workspace.</p><a class="ta-button ta-button-small" data-ai-link="analytics" href={`${base}analytics/`}>Open AI Analytics →</a></div><div class="ta-ai-demo"><img src={`${base}images/ai-analytics-demo.svg`} alt="AI Analytics dashboard demonstration" loading="lazy"/></div></article>
      <article class="ta-ai-card"><span class="ta-free">FREE</span><div class="ta-ai-copy"><span class="ta-mini-label">FREE AI JOURNAL</span><h3>Write. Review. Improve.</h3><p>Capture decisions, review execution and turn repeated observations into practical lessons.</p><a class="ta-button ta-button-small" data-ai-link="journal" href={`${base}journal/`}>Open AI Journal →</a></div><div class="ta-ai-demo"><img src={`${base}images/ai-journal-demo.svg`} alt="AI Journal dashboard demonstration" loading="lazy"/></div></article>
    </div></div></section>

    <section class="ta-section ta-live-section"><div class="ta-container"><div class="ta-section-heading"><span class="ta-mini-label">LIVE INDICATOR</span><h2>See an indicator in action.</h2><p>A clear visual demonstration of the type of chart experience Trade Avata is building.</p></div><a class="ta-live-demo" href={`${base}products/`} aria-label="Open indicator store"><img src={`${base}images/live-indicator.jpg`} alt="Trade Avata live indicator demonstration" loading="lazy"/><span class="ta-live-caption">VIEW INDICATOR STORE →</span></a></div></section>

    <section class="ta-section ta-indicators"><div class="ta-container"><div class="ta-section-heading ta-centered"><span class="ta-mini-label">INDICATOR STORE</span><h2>Featured indicators.</h2><p>Large previews let visitors see the indicator before opening the product.</p></div><div class="ta-filter-row" role="tablist" aria-label="Filter indicators by platform"><button class="is-active" data-filter="all" role="tab">All</button><button data-filter="MetaTrader 4" role="tab">MT4</button><button data-filter="MetaTrader 5" role="tab">MT5</button><button data-filter="cTrader" role="tab">cTrader</button><button data-filter="TradingView" role="tab">TradingView</button></div><div class="ta-indicator-grid" data-indicator-grid></div></div></section>

    <section class="ta-section ta-courses"><div class="ta-container"><div class="ta-section-heading"><span class="ta-mini-label">FREE COURSES</span><h2>Learn. Practice. Grow.</h2><p>Practical courses presented in a clean learning workspace.</p></div><div class="ta-course-grid">
      <a class="ta-course-card" href={`${base}learn/`}><img src={`${base}images/course-1.jpg`} alt="Trading Foundations" loading="lazy"/><div><span>BEGINNER · 8 LESSONS</span><h3>Trading Foundations</h3><p>Build a practical foundation for reading markets.</p></div></a>
      <a class="ta-course-card" href={`${base}learn/`}><img src={`${base}images/course-2.jpg`} alt="Market Structure" loading="lazy"/><div><span>BEGINNER · 10 LESSONS</span><h3>Market Structure</h3><p>Understand structure, trends and key levels.</p></div></a>
      <a class="ta-course-card" href={`${base}learn/`}><img src={`${base}images/course-3.jpg`} alt="Risk Management" loading="lazy"/><div><span>INTERMEDIATE · 7 LESSONS</span><h3>Risk Management</h3><p>Learn practical methods for managing trading risk.</p></div></a>
      <a class="ta-course-card" href={`${base}learn/`}><img src={`${base}images/course-4.jpg`} alt="Trading Psychology" loading="lazy"/><div><span>INTERMEDIATE · 9 LESSONS</span><h3>Trading Psychology</h3><p>Build routines that support disciplined decisions.</p></div></a>
    </div></div></section>

    <section class="ta-community"><div class="ta-community-bg" data-cta-bg></div><div class="ta-container ta-community-inner"><div><span class="ta-mini-label">JOIN THE COMMUNITY</span><h2 data-cta-title>Ready to take your trading to the next level?</h2><p data-cta-description>Get started today and explore the Trade Avata workspace.</p><a class="ta-button ta-button-small" data-cta-link href={`${base}login/`}>Get Started Free →</a></div></div></section>
    <section class="ta-newsletter"><div class="ta-container"><h2>Stay connected with Trade Avata.</h2><p>Get the latest updates, new indicators, courses and trading tips.</p><form onsubmit="return false"><input type="email" placeholder="Enter your email address" aria-label="Email address"/><button>Subscribe →</button></form></div></section>
  </div>
</BaseLayout>
<script>
import { loadHomepageContent } from '../lib/firebase/homepage.js';
const base=document.body.dataset.baseUrl||'/';
const fallback={hero:{primaryLabel:'Get Started Free',primaryUrl:`${base}login/`,secondaryLabel:'Explore Indicators',secondaryUrl:`${base}products/`},ai:{analytics:{url:`${base}analytics/`},journal:{url:`${base}journal/`}},indicators:[
{name:'Trend Momentum Pro',platform:'MetaTrader 4',access:'Free',image:`${base}images/indicator-1.jpg`,url:`${base}products/`,rating:'4.8',reviews:'124'},
{name:'Smart Money Tracker',platform:'MetaTrader 5',access:'Premium',image:`${base}images/indicator-2.jpg`,url:`${base}products/`,rating:'4.7',reviews:'98'},
{name:'Adaptive Scalper',platform:'cTrader',access:'Premium',image:`${base}images/indicator-3.jpg`,url:`${base}products/`,rating:'4.6',reviews:'76'},
{name:'Volatility Breakout',platform:'TradingView',access:'Free',image:`${base}images/indicator-4.jpg`,url:`${base}products/`,rating:'4.5',reviews:'64'}],cta:{title:'Ready to take your trading to the next level?',description:'Get started today and explore the Trade Avata workspace.',image:`${base}images/cta-community.jpg`,url:`${base}login/`}};
const resolve=u=>!u?'':/^(https?:|data:|blob:|#)/i.test(u)?u:`${base}${String(u).replace(/^\/+/, '')}`;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function link(sel,label,url){const n=document.querySelector(sel);if(n){n.textContent=label;n.href=resolve(url)}}
function render(items){const g=document.querySelector('[data-indicator-grid]');g.innerHTML=items.map(i=>`<article class="ta-indicator-card"><div class="ta-indicator-media"><img src="${esc(resolve(i.image||fallback.indicators[0].image))}" alt="${esc(i.name)}" loading="lazy"><span class="ta-platform-badge">${esc(i.platform)}</span><span class="ta-access-badge">${esc(i.access||'Available')}</span></div><div class="ta-indicator-body"><h3>${esc(i.name)}</h3><div class="ta-indicator-meta"><span>★ ${esc(i.rating||'—')} (${esc(i.reviews||'0')})</span><span>${esc(i.platform||'')}</span></div><a class="ta-button ta-button-small" href="${esc(resolve(i.url||`${base}products/`))}">View Details →</a></div></article>`).join('')}
function filters(items){const bs=[...document.querySelectorAll('[data-filter]')];const apply=f=>{bs.forEach(b=>b.classList.toggle('is-active',b.dataset.filter===f));render(f==='all'?items:items.filter(i=>i.platform===f))};bs.forEach(b=>b.onclick=()=>apply(b.dataset.filter));apply('all')}
function apply(d){const x={...fallback,...d,ai:{...fallback.ai,...(d?.ai||{})},cta:{...fallback.cta,...(d?.cta||{})}};link('[data-hero-primary]',`${x.hero.primaryLabel} →`,x.hero.primaryUrl);link('[data-hero-secondary]',x.hero.secondaryLabel,x.hero.secondaryUrl);document.querySelector('[data-ai-link="analytics"]').href=resolve(x.ai.analytics.url);document.querySelector('[data-ai-link="journal"]').href=resolve(x.ai.journal.url);document.querySelector('[data-cta-title]').textContent=x.cta.title;document.querySelector('[data-cta-description]').textContent=x.cta.description;document.querySelector('[data-cta-link]').href=resolve(x.cta.url);document.querySelector('[data-cta-bg]').style.backgroundImage=`url("${resolve(x.cta.image)}")`;filters(Array.isArray(x.indicators)&&x.indicators.length?x.indicators:fallback.indicators)}
function ad(a){const b=document.querySelector('[data-ad-banner]');if(!a||a.enabled!==true){b.hidden=true;return}b.hidden=false;document.querySelector('[data-ad-title]').textContent=a.headline||'Trade smarter with the right tools.';document.querySelector('[data-ad-description]').textContent=a.description||'Indicators, AI analytics and practical trading resources.';const l=document.querySelector('[data-ad-link]');l.href=resolve(a.linkUrl||'#');l.textContent=a.buttonLabel||'Learn more →';if(a.backgroundImage)b.style.setProperty('--ad-image',`url("${resolve(a.backgroundImage)}")`)}
apply(fallback);loadHomepageContent().then(d=>{if(d){apply(d);ad(d.ad)}}).catch(()=>{});
</script>
