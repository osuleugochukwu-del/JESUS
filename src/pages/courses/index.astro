---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {courses} from "../../data/site.js";
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Courses — Trade Avata">
<section class="page"><div class="shell"><span class="eyebrow">Free Courses</span><h1 class="page-title">Learn &amp; Grow Your Skills</h1><p class="lead">Practical trading education from foundations through advanced execution.</p><div class="grid grid-4" style="margin-top:28px">{courses.map(c=><article class="card"><div class="course-image"><span>{c.level}</span></div><div class="card-body"><h3>{c.title}</h3><div class="product-meta"><span>{c.duration}</span><span>{c.lessons} lessons</span></div><p>{c.description}</p><a class="button button-small" href={`${base}courses/${c.slug}/`}>View Course →</a></div></article>)}</div></div></section>
</BaseLayout>