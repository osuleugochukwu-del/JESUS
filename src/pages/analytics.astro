---
import BaseLayout from "../layouts/BaseLayout.astro";
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="AI Analytics — Trade Avata">
<div class="analytics-shell">
<div class="shell analytics-top"><img class="analytics-brand" src={`${base}brand/trade-avata-logo.svg`} alt="Trade Avata"/><div><button class="theme-toggle" data-theme-toggle>☼</button><a class="button button-small" href={`${base}member/`}>Member Area</a></div></div>
<div class="analytics-layout">
<aside class="analytics-side"><b style="font-size:11px;color:#6bbdff">MY TRADING</b>{["dashboard","performance","trades","calendar","strategies","risk","comparisons","bookkeeping","insights","ai-analytics","reports","downloads","accounts"].map((x,i)=><button class={i===0?"active":""} data-a-view={x}>{x==="ai-analytics"?"AI Analytics":x[0].toUpperCase()+x.slice(1)}</button>)}<a href={base} style="margin-top:14px">← Back to Trade Avata</a></aside>
<main class="analytics-main">
<div class="demo-note">DEMO WORKSPACE · The values shown are sample data until a real account connection is enabled.</div>
<section class="view-panel active" data-a-panel="dashboard"><div class="admin-head"><div><span class="eyebrow">Analytics</span><h1 style="font-size:38px;margin:7px 0">Trading Dashboard</h1><p class="muted">What happened, when it happened, and where the results came from.</p></div><button class="button button-small">Customize</button></div>
<div class="kpi-grid"><div class="kpi"><span>Net P&amp;L</span><strong class="positive">+$2,846</strong></div><div class="kpi"><span>Win Rate</span><strong>64.2%</strong></div><div class="kpi"><span>Profit Factor</span><strong>1.84</strong></div><div class="kpi"><span>Max Drawdown</span><strong class="negative">-8.7%</strong></div></div>
<div class="analytics-grid" style="margin-top:14px"><article class="panel"><span class="eyebrow">Equity Curve</span><h2>Account Growth</h2><p>Readable analytical canvas with no skinny widget columns.</p><div class="equity-chart"></div></article><article class="panel"><span class="eyebrow">Account</span><h2>Primary Trading Account</h2><p>DEMO · MetaTrader 5 · USD</p><div class="grid" style="grid-template-columns:1fr 1fr"><div><small>Broker</small><b>Example Broker</b></div><div><small>Balance</small><b>$12,846</b></div><div><small>Trades</small><b>321</b></div><div><small>Leverage</small><b>1:100</b></div></div></article></div>
<div class="analytics-grid" style="margin-top:14px"><article class="panel"><span class="eyebrow">Historical Comparison</span><h2>Current vs Prior Period</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Metric</th><th>Current</th><th>Prior</th><th>Change</th></tr></thead><tbody><tr><td>P&amp;L</td><td>+$2,846</td><td>+$2,318</td><td class="positive">+22.8%</td></tr><tr><td>Win Rate</td><td>64.2%</td><td>61.8%</td><td class="positive">+2.4 pp</td></tr><tr><td>Profit Factor</td><td>1.84</td><td>1.62</td><td class="positive">+0.22</td></tr><tr><td>Max Drawdown</td><td>-8.7%</td><td>-7.4%</td><td class="negative">-1.3 pp</td></tr></tbody></table></div></article><article class="panel"><span class="eyebrow">Trade Distribution</span><h2>Wins vs Losses</h2><div class="kpi-grid"><div class="kpi"><span>Winning</span><strong class="positive">206</strong></div><div class="kpi"><span>Losing</span><strong class="negative">115</strong></div></div><p style="margin-top:12px">Expectancy <b>+$24.80</b> per closed trade.</p></article></div>
<article class="panel" style="margin-top:14px"><span class="eyebrow">Recent Trades</span><h2>Execution</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Symbol</th><th>Side</th><th>Volume</th><th>P&amp;L</th><th>Strategy</th></tr></thead><tbody>{[["30 Sep","EURUSD","BUY","0.50","+$126","Breakout"],["29 Sep","XAUUSD","SELL","0.20","-$84","Reversal"],["28 Sep","GBPUSD","BUY","0.30","+$92","Pullback"],["27 Sep","XAUUSD","BUY","0.15","-$51","Trend"]].map(t=><tr>{t.map(x=><td>{x}</td>)}</tr>)}</tbody></table></div></article>
</section>
{["performance","trades","calendar","strategies","risk","comparisons","bookkeeping","insights","ai-analytics","reports","downloads","accounts"].map(x=><section class="view-panel" data-a-panel={x}><div class="admin-head"><div><span class="eyebrow">{x.replace("-"," ")}</span><h1 style="font-size:38px;margin:7px 0">{x==="ai-analytics"?"AI Analytics":x[0].toUpperCase()+x.slice(1)}</h1><p class="muted">This workspace view is connected to the same demo account model and is ready for backend data.</p></div><button class="button button-small">Export</button></div><div class="kpi-grid"><div class="kpi"><span>Net P&amp;L</span><strong class="positive">+$2,846</strong></div><div class="kpi"><span>Win Rate</span><strong>64.2%</strong></div><div class="kpi"><span>Profit Factor</span><strong>1.84</strong></div><div class="kpi"><span>Drawdown</span><strong class="negative">-8.7%</strong></div></div><article class="panel" style="margin-top:14px"><h2>Workspace ready</h2><p>Use this area for the full {x} dataset when the connected-account backend is enabled. The navigation is intentionally kept in-page so it does not create 404 routes.</p></article></section>)}
</main></div></div>
<script>
document.querySelectorAll("[data-a-view]").forEach(b=>b.addEventListener("click",()=>{const v=b.dataset.aView;document.querySelectorAll("[data-a-view]").forEach(x=>x.classList.toggle("active",x===b));document.querySelectorAll("[data-a-panel]").forEach(x=>x.classList.toggle("active",x.dataset.aPanel===v))}));
</script>
</BaseLayout>