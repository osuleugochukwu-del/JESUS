---
import BaseLayout from "../layouts/BaseLayout.astro"; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Login — Trade Avata"><section class="page"><div class="shell"><div class="split" style="align-items:center"><div class="feature-visual" style="min-height:540px"><div class="device" style="position:absolute;left:8%;right:8%;top:14%;transform:none"><div class="device-screen"></div></div></div><div class="form-card"><span class="eyebrow">Member Area</span><h1 style="font-size:40px;letter-spacing:-.05em;margin:12px 0">Welcome back.</h1><p class="muted">Sign in to access Analytics, Journal, courses and your account.</p><form onsubmit="event.preventDefault();location.href=base+'member/'"><div class="field"><label>Email or username</label><input required placeholder="you@example.com"/></div><div class="field"><label>Password</label><input type="password" required placeholder="••••••••"/></div><label style="display:flex;gap:7px;font-size:11px;margin:12px 0"><input type="checkbox"/> Remember me</label><button class="button" style="width:100%">Login →</button></form><div style="display:flex;justify-content:space-between;margin-top:14px;font-size:11px"><a class="link" href="#">Forgot password?</a><a class="link" href={`${base}register/`}>Create account</a></div></div></div></div></section></BaseLayout>