---
import BaseLayout from "../layouts/BaseLayout.astro"; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Member Area — Trade Avata"><section class="page"><div class="shell"><div class="two-col"><aside class="sidebar-card"><div style="width:54px;height:54px;border-radius:50%;background:#087df0;color:#fff;display:grid;place-items:center;font-weight:900;margin-bottom:10px">TA</div><b>Trade Avata Member</b><p class="muted" style="font-size:10px">Free account</p><a class="active" href="#">Overview</a><a href={`${base}courses/`}>My Courses</a><a href={`${base}journal/`}>Journal</a><a href={`${base}analytics/`}>Analytics</a><a href={`${base}products/`}>Saved Indicators</a><a href="#">Downloads</a><a href="#">Purchases</a><a href="#">Profile &amp; Settings</a></aside><div><span class="eyebrow">Member Area</span><h1 class="page-title" style="font-size:48px">Welcome to your workspace.</h1><div class="kpi-grid"><div class="kpi"><span>Courses in progress</span><strong>2</strong></div><div class="kpi"><span>Completed</span><strong>4</strong></div><div class="kpi"><span>Journal entries</span><strong id="journal-count">0</strong></div><div class="kpi"><span>Saved items</span><strong>6</strong></div></div><div class="section" style="padding-bottom:0"><div class="section-head" style="text-align:left"><span class="eyebrow">Continue Learning</span><h2>Pick up where you left off.</h2></div><div class="grid grid-2"><article class="card card-body"><span class="chip">Intermediate</span><h3>Technical Analysis</h3><div style="height:7px;background:var(--surface2);border-radius:9px;margin:12px 0"><i style="display:block;width:62%;height:100%;background:#087df0;border-radius:9px"></i></div><p>62% complete</p><a class="link" href={`${base}courses/technical-analysis/player/`}>Continue →</a></article><article class="card card-body"><span class="chip">Beginner</span><h3>Trading Basics</h3><div style="height:7px;background:var(--surface2);border-radius:9px;margin:12px 0"><i style="display:block;width:34%;height:100%;background:#16b878;border-radius:9px"></i></div><p>34% complete</p><a class="link" href={`${base}courses/trading-basics/player/`}>Continue →</a></article></div></div></div></div></div></section>
<script>try{document.querySelector("#journal-count").textContent=JSON.parse(localStorage.getItem("ta-journal-v1")||"[]").length}catch{}</script>
</BaseLayout>