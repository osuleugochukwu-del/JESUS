---
import BaseLayout from "../layouts/BaseLayout.astro"; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Admin Control Centre — Trade Avata">
<div class="admin-shell"><div class="admin-layout">
<aside class="admin-side"><img src={`${base}brand/trade-avata-logo.svg`} alt="Trade Avata"/><small style="color:#5fbaff">ADMIN CONTROL CENTRE</small>{["Overview","Live Visitors","Users","Connected Accounts","Products","Courses","Orders & Revenue","Support","Email","Announcements","Audit Logs","System Health","Roles & Permissions","Settings"].map((x,i)=><a class={i===0?"active":""} href="#">{x}</a>)}<a href={base} style="margin-top:15px">← Back to site</a></aside>
<main class="admin-main"><div class="admin-head"><div><span class="eyebrow">ADMIN CONTROL CENTRE · DEMO DATA</span><h1 class="page-title" style="font-size:42px">Platform overview</h1><p class="muted">A real control centre layout for users, activity, products, courses, support and system health.</p></div><span class="health">● SYSTEM HEALTHY</span></div>
<div class="demo-note">DEMO DATA ONLY · Live visitors, user counts, orders and activity below are placeholders. They become real when the admin backend/database is connected.</div>
<div class="kpi-grid"><div class="kpi"><span>Live visitors</span><strong>128</strong><em>now</em></div><div class="kpi"><span>Registered users</span><strong>4,821</strong><em>+6.4% this month</em></div><div class="kpi"><span>Active accounts</span><strong>1,207</strong><em>+3.1%</em></div><div class="kpi"><span>Support tickets</span><strong>17</strong><em>5 awaiting reply</em></div></div>
<div class="activity" style="margin-top:14px"><article class="card card-body"><div class="section-head" style="text-align:left;margin-bottom:12px"><span class="eyebrow">Live Activity</span><h2>Visitors &amp; platform activity</h2></div><div class="activity-list">{[["New user registered","2m ago"],["Indicator purchased","6m ago"],["Course completed","11m ago"],["Support ticket opened","18m ago"],["Account connected","24m ago"]].map(x=><div class="activity-row"><span>{x[0]}</span><small class="muted">{x[1]}</small></div>)}</div></article><article class="card card-body"><span class="eyebrow">System Health</span><h2>Services</h2><p>Frontend <b class="positive">Healthy</b></p><p>Database <b class="positive">Ready</b></p><p>Authentication <b class="positive">Ready</b></p><p>Email <b class="muted">Not connected</b></p><p>Broker bridge <b class="muted">Not connected</b></p></article></div>
<div class="grid grid-3" style="margin-top:14px"><a class="card card-body card-link" href={`${base}products/`}><h3>Products</h3><p>Manage indicator catalog, pricing, platform tags and featured status.</p></a><a class="card card-body card-link" href={`${base}courses/`}><h3>Courses</h3><p>Manage course structure, lessons, thumbnails and access.</p></a><a class="card card-body card-link" href={`${base}contact/`}><h3>Support</h3><p>Connect the support inbox and email routing when the backend is enabled.</p></a></div>
</main></div></div>
</BaseLayout>