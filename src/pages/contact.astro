---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — Trade Avata"><section class="page"><div class="shell"><div class="form-card"><span class="eyebrow">Contact</span><h1 style="font-size:36px;letter-spacing:-.04em">How can we help?</h1><p class="muted">Send a message. This form is ready for the production email endpoint to be connected.</p><form onsubmit="event.preventDefault();this.querySelector('.form-status').textContent='Message captured in this demo. Connect the email backend to send it.'"><div class="field"><label>Name</label><input required placeholder="Your name"/></div><div class="field"><label>Email</label><input type="email" required placeholder="you@example.com"/></div><div class="field"><label>Message</label><textarea rows="5" required placeholder="How can we help?"></textarea></div><button class="button">Send Message →</button><p class="form-status muted" style="font-size:11px"></p></form></div></div></section></BaseLayout>