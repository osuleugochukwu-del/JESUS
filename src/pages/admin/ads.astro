---
import BaseLayout from '../../layouts/BaseLayout.astro'; const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Advertising Manager — Trade Avata" description="Manage Trade Avata advertising placements."><main class="admin-page"><header><div><span class="eyebrow">Admin</span><h1>Advertising Manager</h1><p>Homepage advertising is a full-width banner and can be enabled, edited or removed here.</p></div><a href={`${base}admin/`}>Admin</a></header><form id="adForm" class="card"><label>Placement<select name="placement"><option value="homepage">Homepage</option><option value="aiAnalytics">AI Analytics</option><option value="journal">Journal</option></select></label><label>Provider<select name="provider"><option value="custom">Custom banner</option><option value="adsense">Google AdSense</option></select></label><div class="grid"><label>Banner headline<input name="headline" value="Trade smarter with the right tools."></label><label>Button label<input name="buttonLabel" value="Learn more →"></label></div><label>Description<input name="description" value="Indicators, AI analytics and practical trading resources."></label><label>Destination URL<input name="linkUrl" placeholder="/products/"></label><label>Background image URL<input name="backgroundImage" placeholder="/images/your-ad-banner.webp"></label><label><input name="enabled" type="checkbox"> Enable this placement</label><button>Save ad slot</button></form><p id="status"></p><p class="note">Turn the homepage banner off whenever you do not want an advert displayed. Replace its copy, destination and background without editing the homepage.</p></main></BaseLayout>
<script>
import {watchAuth} from '../../lib/firebase/auth.js';import{getAdminRole,saveAdminDocument,listAdminCollection}from'../../lib/firebase/admin.js';const form=document.querySelector('#adForm'),status=document.querySelector('#status');let role=null;const set=(n,v)=>{if(form.elements[n])form.elements[n].value=v??''};watchAuth(async u=>{if(!u){status.textContent='Sign in required.';return}role=await getAdminRole(u.uid);if(!role){status.textContent='Administrator access required.';return}const rows=await listAdminCollection('adSlots',100);const x=rows.find(r=>r.id==='slot_homepage');if(x){set('headline',x.headline);set('description',x.description);set('buttonLabel',x.buttonLabel);set('linkUrl',x.linkUrl);set('backgroundImage',x.backgroundImage);form.elements.enabled.checked=x.enabled===true}status.textContent='Ready.'});form.addEventListener('submit',async e=>{e.preventDefault();if(!role)return;const f=new FormData(form);try{await saveAdminDocument('adSlots','slot_homepage',{name:'homepage ad',placement:'homepage',provider:f.get('provider'),enabled:f.get('enabled')==='on',headline:f.get('headline'),description:f.get('description'),buttonLabel:f.get('buttonLabel'),linkUrl:f.get('linkUrl'),backgroundImage:f.get('backgroundImage'),format:'full-width-banner'});status.textContent='Homepage banner saved.'}catch(err){status.textContent=err.message}});
</script>
<style>.admin-page{max-width:900px;margin:0 auto;padding:52px 20px}.admin-page header{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.admin-page header a{padding:10px 14px;border:1px solid var(--line);border-radius:10px}.card{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:20px}.card label{display:block;margin:0 0 14px;font-size:13px}.card input,.card select{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:10px}.card label input[type=checkbox]{display:inline-block;width:auto;margin-right:8px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.card button{border:0;border-radius:10px;padding:11px 15px;background:var(--sky);color:#fff;font-weight:750;cursor:pointer}.note,#status{color:var(--muted);margin-top:16px}@media(max-width:600px){.grid{grid-template-columns:1fr}.admin-page header{align-items:start;flex-direction:column}}</style>
