---
import BaseLayout from "../layouts/BaseLayout.astro";
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="AI Journal — Trade Avata"><section class="page"><div class="shell"><div class="section-head" style="text-align:left"><span class="eyebrow">Free AI Journal</span><h1 class="page-title">Track. Learn. Improve.</h1><p class="lead">Record trades and review the decisions behind them. Your entries stay in this browser demo until a database is connected.</p></div>
<div class="two-col"><aside class="sidebar-card"><b>Journal</b><button class="active">Add Trade</button><button>Trade History</button><button>Strategies</button><button>AI Review</button><button>Export</button></aside>
<div><div class="card card-body"><h2>Add Trade</h2><p class="muted">Example: <b>EURUSD · BUY · 0.50 lot · Breakout · +$126</b></p><form id="journal-form"><div class="grid grid-2"><div class="field"><label>Symbol</label><input name="symbol" placeholder="EURUSD" required/></div><div class="field"><label>Direction</label><select name="side"><option>BUY</option><option>SELL</option></select></div><div class="field"><label>Entry</label><input name="entry" placeholder="1.07420"/></div><div class="field"><label>Exit</label><input name="exit" placeholder="1.07610"/></div><div class="field"><label>Risk</label><input name="risk" placeholder="1%"/></div><div class="field"><label>Result</label><input name="result" placeholder="+126"/></div></div><div class="field"><label>Strategy / Setup</label><input name="strategy" placeholder="Breakout — London session"/></div><div class="field"><label>Notes</label><textarea name="notes" rows="4" placeholder="Why did you take this trade? What did you learn?"></textarea></div><button class="button">Save Trade →</button><span id="journal-status" class="muted" style="font-size:11px;margin-left:10px"></span></form></div>
<div class="card card-body" style="margin-top:15px"><h2>Recent Journal Entries</h2><div id="journal-list" class="grid"></div></div></div></div></div></section>
<script>
const key="ta-journal-v1";const form=document.querySelector("#journal-form"),list=document.querySelector("#journal-list"),status=document.querySelector("#journal-status");
function get(){try{return JSON.parse(localStorage.getItem(key)||"[]")}catch{return[]}}function render(){const a=get();list.innerHTML=a.length?a.map(x=>`<div style="padding:12px;border:1px solid var(--line);border-radius:10px"><b>${x.symbol} · ${x.side}</b><span class="muted"> · ${x.result||"No result"}</span><p class="muted" style="margin:4px 0;font-size:11px">${x.strategy||""} — ${x.notes||"No notes"}</p></div>`).join(""):'<p class="muted">No entries yet. Add your first trade above.</p>'}form.addEventListener("submit",e=>{e.preventDefault();const d=Object.fromEntries(new FormData(form));const a=get();a.unshift({...d,createdAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(a.slice(0,50)));form.reset();status.textContent="Saved locally.";render()});render();
</script>
</BaseLayout>